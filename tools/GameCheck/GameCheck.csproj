<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework><OutputType>Exe</OutputType><LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(GameManagedDir)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameManagedDir)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="CheckGameAssemblies" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(GameManagedDir)/Assembly-CSharp.dll')" Text="Pass -p:GameManagedDir=/path/to/current/Managed." />
  </Target>
</Project>
